digraph "SemiCPU" {
label="SemiCPU";
rankdir="LR";
remincross=true;
n3 [ shape=diamond, label="alu_result", color="black", fontcolor="black" ];
n4 [ shape=diamond, label="alu_b", color="black", fontcolor="black" ];
n5 [ shape=diamond, label="rd2", color="black", fontcolor="black" ];
n6 [ shape=diamond, label="rd1", color="black", fontcolor="black" ];
n7 [ shape=diamond, label="use_immediate", color="black", fontcolor="black" ];
n8 [ shape=diamond, label="reg_write", color="black", fontcolor="black" ];
n9 [ shape=diamond, label="immediate", color="black", fontcolor="black" ];
n10 [ shape=diamond, label="rd", color="black", fontcolor="black" ];
n11 [ shape=diamond, label="rs2", color="black", fontcolor="black" ];
n12 [ shape=diamond, label="rs1", color="black", fontcolor="black" ];
n13 [ shape=diamond, label="aluop", color="black", fontcolor="black" ];
n14 [ shape=diamond, label="instruction", color="black", fontcolor="black" ];
n15 [ shape=diamond, label="pc", color="black", fontcolor="black" ];
n16 [ shape=octagon, label="seg", color="black", fontcolor="black" ];
n17 [ shape=octagon, label="an", color="black", fontcolor="black" ];
n18 [ shape=octagon, label="control", color="black", fontcolor="black" ];
n19 [ shape=octagon, label="reset", color="black", fontcolor="black" ];
n20 [ shape=octagon, label="clk", color="black", fontcolor="black" ];
c22 [ shape=record, label="{{<p20> clk|<p21> data}|display_inst\nSevenSegDisplay|{<p17> an|<p16> seg}}",  ];
c27 [ shape=record, label="{{<p23> A|<p24> ALUOp|<p25> B}|alu_inst\nALU|{<p26> Result}}",  ];
c30 [ shape=record, label="{{<p23> A|<p25> B|<p28> S}|$3\n$mux|{<p29> Y}}",  ];
c38 [ shape=record, label="{{<p31> A1|<p32> A2|<p33> A3|<p34> WD3|<p35> WE3|<p20> clk}|regfile_inst\nRegisterFile|{<p36> RD1|<p37> RD2}}",  ];
v0 [ label="0" ];
c39 [ shape=record, label="{{<p23> A|<p25> B|<p28> S}|$2\n$mux|{<p29> Y}}",  ];
c40 [ shape=record, label="{{<p14> instruction}|decoder_inst\nInstructionDecoder|{<p13> aluop|<p9> immediate|<p10> rd|<p8> reg_write|<p12> rs1|<p11> rs2|<p7> use_immediate}}",  ];
c42 [ shape=record, label="{{<p41> address}|imem_inst\nInstructionMemory|{<p14> instruction}}",  ];
c43 [ shape=record, label="{{<p20> clk|<p18> control|<p19> reset}|pc_inst\nProgramCounter|{<p15> pc}}",  ];
x1 [shape=point, ];
