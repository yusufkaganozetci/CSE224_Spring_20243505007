digraph "CPU_TOP" {
label="CPU_TOP";
rankdir="LR";
remincross=true;
n2 [ shape=diamond, label="cpu_result", color="black", fontcolor="black" ];
n3 [ shape=diamond, label="control_edge", color="black", fontcolor="black" ];
n4 [ shape=diamond, label="reset", color="black", fontcolor="black" ];
n5 [ shape=octagon, label="seg", color="black", fontcolor="black" ];
n6 [ shape=octagon, label="an", color="black", fontcolor="black" ];
n7 [ shape=octagon, label="control", color="black", fontcolor="black" ];
n8 [ shape=octagon, label="res", color="black", fontcolor="black" ];
n9 [ shape=octagon, label="clk", color="black", fontcolor="black" ];
c11 [ shape=record, label="{{<p9> clk|<p7> control|<p4> reset}|cpu_inst\nFullCPU|{<p10> Result|<p6> an|<p5> seg}}",  ];
c14 [ shape=record, label="{{<p9> clk|<p4> reset|<p12> signal_in}|edge_det\nEdgeDetector|{<p13> edge_out}}",  ];
c17 [ shape=record, label="{{<p15> A}|$2\n$not|{<p16> Y}}",  ];
x0 [shape=point, ];
c17:p16:e -> x0:w [color="black", fontcolor="black", label=""];
c11:p10:e -> n2:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c14:p13:e -> n3:w [color="black", fontcolor="black", label=""];
n3:e -> c11:p7:w [color="black", fontcolor="black", label=""];
x0:e -> n4:w [color="black", fontcolor="black", label=""];
n4:e -> c11:p4:w [color="black", fontcolor="black", label=""];
n4:e -> c14:p4:w [color="black", fontcolor="black", label=""];
c11:p5:e -> n5:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c11:p6:e -> n6:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n7:e -> c14:p12:w [color="black", fontcolor="black", label=""];
n8:e -> c17:p15:w [color="black", fontcolor="black", label=""];
n9:e -> c11:p9:w [color="black", fontcolor="black", label=""];
n9:e -> c14:p9:w [color="black", fontcolor="black", label=""];
}
